rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'psnkzeducation@gmail.com';
    }

    function isActiveUser() {
      return isAdmin()
        || (
          signedIn()
          && exists(/databases/$(database)/documents/accessUsers/$(request.auth.uid))
          && get(/databases/$(database)/documents/accessUsers/$(request.auth.uid)).data.active == true
          && get(/databases/$(database)/documents/accessUsers/$(request.auth.uid)).data.archived != true
          && get(/databases/$(database)/documents/accessUsers/$(request.auth.uid)).data.get('passwordResetRequested', false) != true
          && get(/databases/$(database)/documents/accessUsers/$(request.auth.uid)).data.get('claimState', 'claimed') == 'claimed'
        );
    }

    match /materials/{materialId} {
      // Staff content is served by /api/content after audience checks.
      allow read: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          isActiveUser()
          &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
          && request.resource.data.views == resource.data.get('views', 0) + 1
        );
    }

    match /videoCategories/{categoryId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /tracks/{trackId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /catalogMeta/{metaId} {
      allow read, write: if isAdmin();
    }

    match /trainingGroups/{groupId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /materialViews/{viewId} {
      allow get: if isActiveUser();
      allow list: if false;
      allow create: if isActiveUser()
        && request.resource.data.keys().hasOnly([
          'materialId',
          'deviceId',
          'createdAt'
        ])
        && request.resource.data.materialId is string
        && request.resource.data.deviceId is string
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /learningProgress/{progressId} {
      allow get, list: if isAdmin()
        || (isActiveUser() && resource.data.userId == request.auth.uid);
      allow create, update: if isActiveUser()
        && request.resource.data.keys().hasOnly([
          'userId',
          'materialId',
          'materialTitle',
          'completedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.materialId is string
        && request.resource.data.materialTitle is string
        && request.resource.data.completedAt == request.time
        && (
          !exists(/databases/$(database)/documents/learningProgress/$(progressId))
          || resource.data.userId == request.auth.uid
        );
      allow delete: if false;
    }

    match /accessUsers/{userId} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow list, create, update, delete: if isAdmin();
    }

    match /loginEvents/{eventId} {
      allow read: if isAdmin();
      allow create: if isActiveUser()
        && request.resource.data.keys().hasOnly([
          'uid',
          'login',
          'createdAt',
          'userAgent'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.login is string
        && request.resource.data.userAgent is string
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /adminImpersonations/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /importHistory/{eventId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
